# Confirmed canonical public marketing origin. Never use the portal hostname.
NEXT_PUBLIC_SITE_URL=https://attolearn.com
# Production enables indexing by default. Set false for EVERY preview/staging build.
SEO_INDEXING_ENABLED=false
# Optional Search Console URL-prefix verification token; not domain DNS verification.
GOOGLE_SITE_VERIFICATION=
# Set only after the institution destination has been approved.
NEXT_PUBLIC_ATTOCAMPUS_URL=
